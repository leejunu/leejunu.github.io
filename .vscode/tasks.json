{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve website (live reload)",
      "type": "process",
      "command": "python3",
      "args": [
        ".vscode/live_server.py",
        "--port",
        "5500"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
